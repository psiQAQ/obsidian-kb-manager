{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge Base Manager template declaration",
  "description": "Protocol 1 for kb-template.json. File existence, safe vault paths, unique identifiers and installed plugin versions are verified by the manager.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor schema location."
    },
    "protocolVersion": {
      "const": 1,
      "description": "Omitted in legacy templates."
    },
    "minManagerVersion": {
      "$ref": "#/definitions/semver"
    },
    "id": {
      "$ref": "#/definitions/text"
    },
    "version": {
      "$ref": "#/definitions/text",
      "description": "Author's template revision."
    },
    "name": {
      "$ref": "#/definitions/text"
    },
    "description": {
      "type": "string"
    },
    "purpose": {
      "$ref": "#/definitions/slug"
    },
    "purposes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/slug"
      }
    },
    "entry": {
      "$ref": "#/definitions/path"
    },
    "pageTemplates": {
      "$ref": "#/definitions/paths"
    },
    "suggestedExcludedFolders": {
      "$ref": "#/definitions/paths"
    },
    "defaultExcludedFolders": {
      "description": "Initially selected subset of suggestedExcludedFolders. Defaults to all suggestions.",
      "$ref": "#/definitions/paths"
    },
    "diagnosticExclusions": {
      "description": "Skip selected diagnostic checks on the named files or folder descendants in the instance.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checks"],
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["links", "anchors", "portability", "bases"]
            }
          },
          "files": {"$ref": "#/definitions/diagnosticPaths"},
          "folders": {"$ref": "#/definitions/diagnosticPaths"}
        },
        "anyOf": [
          {"required": ["files"], "properties": {"files": {"minItems": 1}}},
          {"required": ["folders"], "properties": {"folders": {"minItems": 1}}}
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/text"
          },
          {
            "type": "object",
            "required": [
              "id",
              "required"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/definitions/text"
              },
              "required": {
                "type": "boolean"
              },
              "minVersion": {
                "$ref": "#/definitions/semver"
              }
            }
          }
        ]
      }
    },
    "managedFiles": {
      "description": "Paths to ordinary template text files (.md, .base, .canvas, .txt, .json, .yaml, .yml or .css). The manager checks each installed baseline before updating.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/path"
          },
          {
            "not": {
              "anyOf": [
                {
                  "pattern": "^checks/"
                },
                {
                  "enum": [
                    "kb-template.json",
                    "kb.toml",
                    "kb-manager.json"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "managed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "knowledge.base:overview-bindings"
      }
    },
    "hidden": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "paths": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/path"
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "text": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/path"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "kb_name",
            "description",
            "kb_root"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "author",
          "commit",
          "license"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "author": {
            "$ref": "#/definitions/text"
          },
          "commit": {
            "$ref": "#/definitions/text"
          },
          "license": {
            "$ref": "#/definitions/text"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$",
            "not": {
              "enum": [
                "manifest",
                "properties",
                "links",
                "anchors",
                "canvas",
                "bases",
                "bindings",
                "portability",
                "all"
              ]
            }
          },
          "name": {
            "$ref": "#/definitions/text"
          },
          "description": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^checks/[^/]+\\.mjs$"
          },
          "linkEvidence": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "id",
          "version"
        ]
      }
    },
    {
      "if": {
        "required": [
          "managedFiles"
        ],
        "properties": {
          "managedFiles": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "id",
          "version"
        ]
      }
    }
  ],
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:*?\"<>|\\u0000-\\u001f]+$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/path"
      }
    },
    "diagnosticPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [
          {"$ref": "#/definitions/path"},
          {"not": {"pattern": "(^|/)([.]|\\s)|([.]|\\s)(/|$)|/$|[\\[\\]{}]"}}
        ]
      }
    }
  }
}
