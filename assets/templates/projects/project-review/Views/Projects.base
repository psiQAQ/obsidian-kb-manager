filters:
  and:
    - file.path.startsWith("{{kb_root}}/")
    - this.file.path.startsWith("{{kb_root}}/")
    - file.ext == "md"
    - '!file.inFolder("{{kb_root}}/Templates")'
    - '!file.inFolder("{{kb_root}}/Integrations")'
views:
  - type: table
    name: 项目
    filters:
      and:
        - type == "review-project"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
  - type: table
    name: 周期笔记
    filters:
      and:
        - type == "project-review"
    order:
      - file.name
      - week
    sort:
      - property: week
        direction: ASC
