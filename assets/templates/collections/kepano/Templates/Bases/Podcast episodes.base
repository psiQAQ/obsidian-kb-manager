filters:
  and:
    - file.path.startsWith("__KB_ROOT__/")
    - note.categories.contains(link("__KB_ROOT__/Categories/Podcast episodes"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Podcast
  note.show:
    displayName: Show
  note.guests:
    displayName: Guests
  note.episode:
    displayName: Episode
  note.rating:
    displayName: Rating
  note.published:
    displayName: Published
views:
  - type: table
    name: All episodes
    order:
      - file.name
      - show
      - guests
      - episode
      - rating
      - published
    sort:
      - property: published
        direction: DESC
  - type: table
    name: Show
    filters:
      and:
        - list(show).contains(this)
    order:
      - file.name
      - show
      - episode
      - rating
      - published
      - guests
  - type: table
    name: Guest
    filters:
      and:
        - list(guests).contains(this)
    order:
      - file.name
      - show
      - guests
      - episode
      - rating
      - published
