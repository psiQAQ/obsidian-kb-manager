filters:
  and:
    - file.path.startsWith("__KB_ROOT__/")
    - '!file.name.contains("Template")'
    - tags.contains("journal")
properties:
  file.name:
    displayName: Entry
  note.created:
    displayName: Created
views:
  - type: table
    name: Table
    order:
      - file.name
      - created
