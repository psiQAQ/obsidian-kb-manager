filters:
  and:
    - file.path.startsWith("{{kb_root}}/")
    - this.file.path.startsWith("{{kb_root}}/")
    - file.ext == "md"
    - '!file.inFolder("{{kb_root}}/Templates")'
    - '!file.inFolder("{{kb_root}}/Integrations")'
formulas:
  stage: 'if(status == "assess", "1 评估", if(status == "trial", "2 试用", if(status == "adopt", "3 采用", if(status == "hold", "4 暂缓", "未指定"))))'
views:
  - type: table
    name: 按阶段
    filters:
      and:
        - type == "radar-tool"
    order:
      - file.name
      - status
      - topic
      - adoption_reason
    groupBy:
      property: formula.stage
      direction: ASC
  - type: table
    name: 待验证
    filters:
      and:
        - type == "radar-tool"
        - status == "assess" || status == "trial"
    order:
      - file.name
      - topic
      - history
