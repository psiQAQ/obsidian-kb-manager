filters:
  and:
    - file.path.startsWith("{{kb_root}}/")
    - this.file.path.startsWith("{{kb_root}}/")
    - file.ext == "md"
    - '!file.inFolder("{{kb_root}}/Templates")'
    - '!file.inFolder("{{kb_root}}/Integrations")'
views:
  - type: table
    name: 日记
    filters:
      and:
        - type == "journal"
    order:
      - file.name
      - date
    sort:
      - property: date
        direction: ASC
  - type: table
    name: 归档札记
    filters:
      and:
        - type == "jot"
    order:
      - file.name
      - date
    sort:
      - property: date
        direction: ASC
