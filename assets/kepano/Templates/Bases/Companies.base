filters:
  and:
    - file.path.startsWith("__KB_ROOT__/")
    - categories.contains(link("__KB_ROOT__/Categories/Companies"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Company
  property.url:
    displayName: Link
  note.url:
    displayName: URL
  note.people:
    displayName: People
views:
  - type: table
    name: Companies
    order:
      - file.name
      - url
      - people
    columnSize:
      note.url: 239
