filters:
  and:
    - file.path.startsWith("__KB_ROOT__/")
    - note.categories.contains(link("__KB_ROOT__/Categories/Podcasts"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Podcast
  note.host:
    displayName: Host
views:
  - type: table
    name: Table
    order:
      - file.name
      - host
